# Copy this file to .env and fill in credentials for the stages you plan to run.
# Never commit .env to version control.

# Stage 1: Gemini API (script refinement & Amharic narration)
GEMINI_API_KEY=
GEMINI_SCRIPT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Charon
GEMINI_TEMPERATURE=0.6
GEMINI_SEED=42

# Stage 2: Cloudflare Workers AI (keyframe image generation)
CLOUDFLARE_ACCOUNT_ID= 7f26df38965d401ab70b9976d8f265c6
CLOUDFLARE_API_TOKEN= cfut_cLPDLOJlUSG0v9oGiqUZd2wCHNJjsIGRVwvd9tv5099fc303
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b
CLOUDFLARE_IMAGE_GUIDANCE=4.0

# Stage 3: Wan 2.2 (image-to-video generation endpoint)
WAN_API_URL=
WAN_API_KEY=
WAN_MODEL_NAME=wan-2.2

# Stage 4: ACE-Step (original soundtrack generation endpoint)
ACESTEP_API_URL=
ACESTEP_API_KEY=
ACESTEP_MODEL_NAME=ace-step

# Stage 5: FFmpeg (final assembly)
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Runtime behavior
MAMUSH_CACHE_ENABLED=true
MAMUSH_LOG_LEVEL=INFO
