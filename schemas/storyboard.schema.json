{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mamush-ai-film.local/schemas/storyboard.schema.json",
  "title": "Mamush AI Film Storyboard Contract",
  "description": "Central contract governing script, narration, keyframes, video clips, music, and FFmpeg assembly for ማሙሽ - የእናት ፍቅር.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "characters",
    "style_guide",
    "music",
    "shots",
    "assembly"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "english_title",
        "logline",
        "language",
        "target_duration_sec",
        "aspect_ratio",
        "resolution",
        "fps"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "english_title": {
          "type": "string",
          "minLength": 1
        },
        "logline": {
          "type": "string",
          "minLength": 10
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        },
        "target_duration_sec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {
              "type": "number",
              "minimum": 60,
              "maximum": 90
            },
            "max": {
              "type": "number",
              "minimum": 60,
              "maximum": 90
            }
          }
        },
        "aspect_ratio": {
          "type": "string",
          "enum": ["16:9", "9:16", "2.39:1", "4:3"]
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 320,
              "maximum": 3840
            },
            "height": {
              "type": "integer",
              "minimum": 240,
              "maximum": 2160
            }
          }
        },
        "fps": {
          "type": "integer",
          "enum": [24, 25, 30]
        }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "visual_bible"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "visual_bible": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "style_guide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_style",
        "color_palette",
        "lighting",
        "cinematography_notes",
        "negative_prompt"
      ],
      "properties": {
        "visual_style": {
          "type": "string",
          "minLength": 5
        },
        "color_palette": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "lighting": {
          "type": "string",
          "minLength": 5
        },
        "cinematography_notes": {
          "type": "string",
          "minLength": 5
        },
        "negative_prompt": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_status",
        "prompt",
        "lyrics_or_tags",
        "tempo_bpm",
        "duration_sec",
        "mood_progression",
        "output_path",
        "cache_key"
      ],
      "properties": {
        "stage_status": {
          "type": "string",
          "enum": ["pending", "cached", "generated", "approved", "failed"]
        },
        "prompt": {
          "type": "string",
          "minLength": 10
        },
        "lyrics_or_tags": {
          "type": "string"
        },
        "tempo_bpm": {
          "type": "integer",
          "minimum": 40,
          "maximum": 200
        },
        "duration_sec": {
          "type": "number",
          "minimum": 60,
          "maximum": 90
        },
        "mood_progression": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["time_sec", "mood"],
            "properties": {
              "time_sec": {
                "type": "number",
                "minimum": 0
              },
              "mood": {
                "type": "string",
                "minLength": 2
              }
            }
          }
        },
        "output_path": {
          "type": ["string", "null"]
        },
        "cache_key": {
          "type": ["string", "null"]
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shot_id",
          "order",
          "act",
          "scene_title",
          "duration_sec",
          "character_ids",
          "setting",
          "time_of_day",
          "camera",
          "narration",
          "keyframe",
          "video",
          "transition_out",
          "stage_status"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "pattern": "^shot_[0-9]{2,3}$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "act": {
            "type": "string",
            "enum": ["setup", "obstacle", "support", "resolution"]
          },
          "scene_title": {
            "type": "string",
            "minLength": 2
          },
          "duration_sec": {
            "type": "number",
            "minimum": 3.0,
            "maximum": 15.0
          },
          "character_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "setting": {
            "type": "string",
            "minLength": 5
          },
          "time_of_day": {
            "type": "string",
            "enum": [
              "dawn",
              "morning",
              "midday",
              "afternoon",
              "golden_hour",
              "dusk",
              "night"
            ]
          },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "required": ["shot_type", "movement", "lens_mm"],
            "properties": {
              "shot_type": {
                "type": "string",
                "enum": [
                  "extreme_wide",
                  "wide",
                  "medium_wide",
                  "medium",
                  "medium_close_up",
                  "close_up",
                  "extreme_close_up",
                  "over_the_shoulder"
                ]
              },
              "movement": {
                "type": "string",
                "enum": [
                  "static",
                  "slow_pan_right",
                  "slow_pan_left",
                  "tilt_up",
                  "tilt_down",
                  "push_in",
                  "pull_back",
                  "tracking_follow",
                  "handheld_gentle"
                ]
              },
              "lens_mm": {
                "type": "integer",
                "minimum": 14,
                "maximum": 200
              }
            }
          },
          "narration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "language",
              "text_am",
              "text_en",
              "emotion",
              "start_sec",
              "end_sec",
              "audio_path",
              "cache_key"
            ],
            "properties": {
              "language": {
                "type": "string",
                "minLength": 2
              },
              "text_am": {
                "type": "string",
                "minLength": 1
              },
              "text_en": {
                "type": "string",
                "minLength": 1
              },
              "emotion": {
                "type": "string",
                "minLength": 2
              },
              "start_sec": {
                "type": "number",
                "minimum": 0
              },
              "end_sec": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "audio_path": {
                "type": ["string", "null"]
              },
              "cache_key": {
                "type": ["string", "null"]
              }
            }
          },
          "keyframe": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prompt",
              "negative_prompt",
              "seed",
              "image_path",
              "cache_key"
            ],
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 10
              },
              "negative_prompt": {
                "type": "string"
              },
              "seed": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "image_path": {
                "type": ["string", "null"]
              },
              "cache_key": {
                "type": ["string", "null"]
              }
            }
          },
          "video": {
            "type": "object",
            "additionalProperties": false,
            "required": ["motion_prompt", "fps", "clip_path", "cache_key"],
            "properties": {
              "motion_prompt": {
                "type": "string",
                "minLength": 10
              },
              "fps": {
                "type": "integer",
                "enum": [24, 25, 30]
              },
              "clip_path": {
                "type": ["string", "null"]
              },
              "cache_key": {
                "type": ["string", "null"]
              }
            }
          },
          "transition_out": {
            "type": "string",
            "enum": ["cut", "crossfade", "fade_black"]
          },
          "stage_status": {
            "type": "object",
            "additionalProperties": false,
            "required": ["narration", "keyframe", "video"],
            "properties": {
              "narration": {
                "type": "string",
                "enum": ["pending", "cached", "generated", "failed"]
              },
              "keyframe": {
                "type": "string",
                "enum": ["pending", "cached", "generated", "failed"]
              },
              "video": {
                "type": "string",
                "enum": ["pending", "cached", "generated", "failed"]
              }
            }
          }
        }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_status",
        "output_path",
        "subtitle_path",
        "narration_script_path",
        "audio_mix",
        "subtitles_enabled"
      ],
      "properties": {
        "stage_status": {
          "type": "string",
          "enum": ["pending", "assembled", "failed"]
        },
        "output_path": {
          "type": ["string", "null"]
        },
        "subtitle_path": {
          "type": ["string", "null"]
        },
        "narration_script_path": {
          "type": ["string", "null"]
        },
        "audio_mix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["narration_gain_db", "music_gain_db", "music_ducking_db"],
          "properties": {
            "narration_gain_db": {
              "type": "number",
              "minimum": -24,
              "maximum": 12
            },
            "music_gain_db": {
              "type": "number",
              "minimum": -36,
              "maximum": 6
            },
            "music_ducking_db": {
              "type": "number",
              "minimum": -24,
              "maximum": 0
            }
          }
        },
        "subtitles_enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
